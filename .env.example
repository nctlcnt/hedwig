GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost

# Preferred multi-account config. Copy config/gmail-accounts.example.json to this path,
# or let npm run google:auth -- <account_id> "<Display Name>" create/update it.
GMAIL_ACCOUNTS_JSON=config/gmail-accounts.json

# Single-account fallback. Used when GMAIL_ACCOUNTS is not set.
GMAIL_ACCOUNT_NAME=Primary Gmail
GOOGLE_REFRESH_TOKEN=

# Legacy env multi-account mode. Format: account_id:Display Name:REFRESH_TOKEN_ENV
# GMAIL_ACCOUNTS=main:Main Gmail:GOOGLE_REFRESH_TOKEN_MAIN,school:School Gmail:GOOGLE_REFRESH_TOKEN_SCHOOL
# GOOGLE_REFRESH_TOKEN_MAIN=
# GOOGLE_REFRESH_TOKEN_SCHOOL=

DISCORD_BOT_TOKEN=
DISCORD_DIGEST_CHANNEL_ID=
# Optional. Without it action-class push notifications are skipped (the email
# still shows up in the next digest). Set this to a different channel than
# DISCORD_DIGEST_CHANNEL_ID to avoid duplicates.
DISCORD_REALTIME_CHANNEL_ID=

# Optional
CLASSIFIER_PROVIDER=openai-compatible
CLASSIFIER_API_BASE_URL=https://api.deepseek.com
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=deepseek-v4-pro
CLASSIFIER_PROVIDER_NAME=deepseek
# GLM example:
# CLASSIFIER_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CLASSIFIER_MODEL=glm-4.7
# CLASSIFIER_PROVIDER_NAME=glm
DIGEST_TIMEZONE=Australia/Sydney
DIGEST_CRON=0 19 * * *
GMAIL_LOOKBACK_HOURS=24
GMAIL_MAX_MESSAGES=100
GMAIL_UNREAD_ONLY=true
SQLITE_PATH=data/hedwig.db
