GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost

# Preferred multi-account config. Copy config/gmail-accounts.example.json to this path,
# or let npm run google:auth -- <account_id> "<Display Name>" create/update it.
GMAIL_ACCOUNTS_JSON=config/gmail-accounts.json

# Single-account fallback. Used when GMAIL_ACCOUNTS is not set.
GMAIL_ACCOUNT_NAME=Primary Gmail
GOOGLE_REFRESH_TOKEN=

# Legacy env multi-account mode. Format: account_id:Display Name:REFRESH_TOKEN_ENV
# GMAIL_ACCOUNTS=main:Main Gmail:GOOGLE_REFRESH_TOKEN_MAIN,school:School Gmail:GOOGLE_REFRESH_TOKEN_SCHOOL
# GOOGLE_REFRESH_TOKEN_MAIN=
# GOOGLE_REFRESH_TOKEN_SCHOOL=

DISCORD_BOT_TOKEN=
DISCORD_DIGEST_CHANNEL_ID=
# Optional. Without it action-class push notifications are skipped (the email
# still shows up in the next digest). Set this to a different channel than
# DISCORD_DIGEST_CHANNEL_ID to avoid duplicates.
DISCORD_REALTIME_CHANNEL_ID=
# Optional operational-error channel. Crashes, account failures, Discord send
# failures, and classifier rule-fallbacks are posted here, deduped: the same
# problem is silenced for DISCORD_DEBUG_COOLDOWN_MINUTES after it fires, so a
# persistent error pings once per window instead of every run. Leave unset to
# disable debug alerts entirely.
DISCORD_DEBUG_CHANNEL_ID=
DISCORD_DEBUG_COOLDOWN_MINUTES=60

# Optional follow-up workflow. When disabled, the Forum channel value is
# ignored and not validated. When enabled, the ID is required and startup
# verifies that the bot can access a Discord Forum channel at that ID.
FOLLOWUP_ENABLED=false
DISCORD_FOLLOWUP_FORUM_CHANNEL_ID=

# Optional
CLASSIFIER_PROVIDER=openai-compatible
CLASSIFIER_API_BASE_URL=https://api.deepseek.com
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=deepseek-v4-pro
CLASSIFIER_PROVIDER_NAME=deepseek
# GLM example:
# CLASSIFIER_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CLASSIFIER_MODEL=glm-4.7
# CLASSIFIER_PROVIDER_NAME=glm
# Optional backup classifier. Tried only when the primary call above fails
# (rate limit / outage / insufficient balance), before falling back to the rule
# classifier. Set CLASSIFIER_FALLBACK_API_KEY to activate; the other fields
# inherit from the primary classifier when omitted (so a backup that only swaps
# the model needs just the key + CLASSIFIER_FALLBACK_MODEL).
# CLASSIFIER_FALLBACK_API_KEY=
# CLASSIFIER_FALLBACK_API_BASE_URL=https://api.deepseek.com
# CLASSIFIER_FALLBACK_MODEL=deepseek-v4-pro
# CLASSIFIER_FALLBACK_PROVIDER_NAME=deepseek
# Per-request resilience for the LLM classifier. maxRetries drives the SDK's
# exponential backoff (honors Retry-After), so a 429 rate limit self-throttles
# and retries instead of immediately dropping to the backup/rule classifier.
CLASSIFIER_MAX_RETRIES=4
CLASSIFIER_TIMEOUT_MS=60000
# Optional natural-language rules appended to the classifier prompt (LLM only).
# Copy config/classifier-rules.example.md to this path and edit it.
CLASSIFIER_RULES_FILE=config/classifier-rules.md
DIGEST_TIMEZONE=Australia/Sydney
DIGEST_CRON=0 19 * * *
DIGEST_PROCESS_CRON=*/5 * * * *
GMAIL_LOOKBACK_HOURS=24
GMAIL_MAX_MESSAGES=100

SQLITE_PATH=data/hedwig.db
