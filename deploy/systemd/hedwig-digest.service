[Unit]
Description=Hedwig Gmail digest daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/stacks/hedwig
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run digest:daemon
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
